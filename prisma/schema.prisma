generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enumerado de estados según tus responsabilidades
enum EstadoReserva {
  PENDING_DRIVER
  CONFIRMED
  PAID
  DENIED
  CANCELED
}

model Pasajero {
  clerk_user_id String  @id
  nombre         String?
  email          String? @unique
  rol            String  @default("RIDER")
  company_code   String? 
  reservas       Reserva[]
  notificaciones Notificacion[]
}

model Reserva {
  id                String      @id @default(cuid())
  clerk_user_id      String
  pool_id            String?     // ID externo de la Driver App (opcional hasta asignación)
  estado_reserva    EstadoReserva @default(PENDING_DRIVER)
  punto_de_partida  String
  destino_id        String
  horario            DateTime
  precio_maximo      Float?      // Precio informado al reservar
  precio_efectivo    Float?      // Precio final pagado
  payment_transaction_id   String? // ID de transacción en Payments App
  assigned_driver_snapshot Json? // Snapshot de los datos del chofer/vehiculo al asignar

  pasajero          Pasajero    @relation(fields: [clerk_user_id], references: [clerk_user_id])
  destino           Destino     @relation(fields: [destino_id], references: [id])
}

model Destino {
  id                String      @id @default(cuid())
  nombre            String
  ubicacion_lat_long String
  reservas          Reserva[]
}

// Tabla temporal usada EXCLUSIVAMENTE para el simulador visual de la Home
model Pool {
  id               String   @id @default(cuid())
  conductor_nombre String
  vehiculo_patente String
  estado           String   @default("Programado")
  fecha_viaje      DateTime @default(now())
}

model Notificacion {
  id            String    @id @default(cuid())
  clerk_user_id String
  tipo          String    // ej: TRIP_STARTED, DRIVER_ARRIVED, PAYMENT_DENIED
  read_at       DateTime? // Si es null significa que no fue leída

  pasajero      Pasajero  @relation(fields: [clerk_user_id], references: [clerk_user_id])
}