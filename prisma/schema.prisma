generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enumerado de estados según el contrato
enum ReservationStatus {
  PENDING_DRIVER
  CONFIRMED
  PAID
  DENIED
  CANCELED
}

model Passenger {
  id            String   @id @default(cuid())
  clerk_user_id String   @unique
  full_name     String
  phone         String
  company_code  String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  
  // Campos extra operativos (no estorban al modelo original)
  email         String?  @unique
  rol           String   @default("RIDER")

  reservations  Reservation[]
  notifications PassengerNotification[]

  @@map("passengers")
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  lat         Float
  lng         Float
  active      Boolean  @default(true)

  reservations Reservation[]

  @@map("destinations")
}

model Reservation {
  id                       String   @id @default(cuid())
  passenger_id             String
  passenger_user_id        String
  pool_id                  String?
  destination_id           String
  departure_time           DateTime
  pickup_address           String
  pickup_lat               Float?
  pickup_lng               Float?
  status                   ReservationStatus @default(PENDING_DRIVER)
  max_price                Float?
  effective_price          Float?
  currency                 String   @default("ARS")
  payment_transaction_id   String?
  payment_rejection_reason String?
  assigned_driver_snapshot Json?

  passenger   Passenger   @relation(fields: [passenger_id], references: [id])
  destination Destination @relation(fields: [destination_id], references: [id])

  @@map("reservations")
}

// Tabla temporal usada EXCLUSIVAMENTE para el simulador visual de Combis en la Home (fuera del contrato)
model Pool {
  id               String   @id @default(cuid())
  conductor_nombre String
  vehiculo_patente String
  estado           String   @default("Programado")
  fecha_viaje      DateTime @default(now())
}

model PassengerNotification {
  id                String    @id @default(cuid())
  passenger_user_id String
  reservation_id    String?
  pool_id           String?
  type              String    // ej: POOL_CANCELED, PAYMENT_DENIED
  message           String
  read_at           DateTime?
  created_at        DateTime  @default(now())

  passenger Passenger @relation(fields: [passenger_user_id], references: [clerk_user_id])

  @@map("passenger_notifications")
}